{
  "name": "@boynchan/pi-agent-trajectory",
  "version": "0.1.0",
  "description": "Append-only, auditable execution trajectories for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "author": "BoynChan",
  "keywords": [
    "pi-package",
    "pi-agent",
    "trajectory",
    "observability",
    "audit"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "pi-trajectory": "./src/cli.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
